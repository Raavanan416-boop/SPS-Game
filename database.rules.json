{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "status": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid)"
      }
    },
    "friendRequests": {
      "$receiverUid": {
        ".read": "auth != null && auth.uid === $receiverUid",
        "$senderUid": {
          ".write": "auth != null && (auth.uid === $senderUid || auth.uid === $receiverUid)"
        }
      }
    },
    "challenges": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "matches": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$matchId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
